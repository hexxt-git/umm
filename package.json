{
  "name": "umm",
  "version": "0.1.0",
  "description": "A faster way to ask. Direct, structured answers in your terminal.",
  "type": "module",
  "bin": {
    "umm": "dist/index.js"
  },
  "scripts": {
    "build:skill": "node scripts/embed-skill.ts",
    "build": "npm run build:skill && tsc -p tsconfig.build.json && node scripts/postbuild.ts",
    "build:binaries": "npm run build:skill && bash scripts/build-binaries.sh",
    "typecheck": "npm run build:skill && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "lint-staged",
    "prepack": "npm run build",
    "dev": "bun src/index.ts",
    "prepare": "husky && node scripts/embed-skill.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,jsonc,html,css,md,yml,yaml}": "prettier --write"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
